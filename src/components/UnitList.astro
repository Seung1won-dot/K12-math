---
import { STATUS_LABEL, unitUrl, type Unit } from '../lib/units';
interface Props { units: Unit[] }
const { units } = Astro.props;
---
<ul class="unit-list">
  {units.map((u) => (
    <li>
      <span><span class="id">{u.data.id}</span><a href={unitUrl(u.data.id)}>{u.data.title}</a></span>
      <span class={`badge ${u.data.status}`}>{STATUS_LABEL[u.data.status]}</span>
    </li>
  ))}
</ul>
