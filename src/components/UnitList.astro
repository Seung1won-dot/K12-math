---
import { STATUS_LABEL, parseId, unitUrl, type Unit } from '../lib/units';
interface Props { units: Unit[] }
const { units } = Astro.props;
---
<ul class="unit-list">
  {units.map((u) => (
    <li>
      <a href={unitUrl(u.data.id)}>
        <span class="seq">{String(parseId(u.data.id).seq).padStart(2, '0')}</span>
        <span class="title">{u.data.title}</span>
        <span class="area">{u.data.area}</span>
        <span class={`chip chip--${u.data.status}`}>{STATUS_LABEL[u.data.status]}</span>
        <svg class="go" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
      </a>
    </li>
  ))}
</ul>
