---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { withBase } from '../lib/units';

interface Props {
  title: string;
  description?: string;
}
const { title, description = '초등부터 고등까지 수학 개념과 공식을 학년별로 정리한 사이트' } = Astro.props;
const siteName = '수학 전체 정리';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
    <title>{title === siteName ? title : `${title} · ${siteName}`}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase('/')}>{siteName}</a>
      <nav>
        <a href={withBase('/elem/')}>초등</a>
        <a href={withBase('/mid/')}>중등</a>
        <a href={withBase('/high/')}>고등</a>
        <a href={withBase('/search/')}>검색</a>
      </nav>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <p>2022 개정 교육과정 기준. 콘텐츠 CC BY-NC-SA 4.0 · 코드 MIT.</p>
      <p><a href="https://github.com/Seung1won-dot/K12-math">GitHub</a></p>
    </footer>
  </body>
</html>
