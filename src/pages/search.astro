---
import Base from '../layouts/Base.astro';
import Search from 'astro-pagefind/components/Search.astro';
---
<Base title="검색">
  <h1>검색</h1>
  <p class="muted">단원명, 공식, 키워드로 전 학년을 한 번에 찾습니다. 검색 인덱스는 빌드 시 생성되므로 <code>npm run build</code> 후 <code>npm run preview</code>에서 동작합니다.</p>
  <Search id="search" className="pagefind-ui" searchboxOptions={{ placeholder: '예: 피타고라스, 분수 나눗셈' }} />
</Base>
