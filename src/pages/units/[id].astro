---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { STATUS_LABEL, groupLabel, parseId, sortUnits, unitUrl, levelUrl, LEVEL_LABEL, type Unit } from '../../lib/units';

export async function getStaticPaths() {
  const units = await getCollection('units');
  return units.map((unit) => ({ params: { id: unit.data.id }, props: { unit } }));
}
const { unit } = Astro.props as { unit: Unit };
const all = await getCollection('units');
const byId = new Map(all.map((u) => [u.data.id, u]));
const { Content, headings } = await render(unit);
const d = unit.data;
const { level, group } = parseId(d.id);

const siblings = sortUnits(all.filter((u) => parseId(u.data.id).level === level && parseId(u.data.id).group === group));
const idx = siblings.findIndex((u) => u.data.id === d.id);
const prev = siblings[idx - 1];
const next = siblings[idx + 1];
const prereqs = d.prerequisites.map((id) => byId.get(id)).filter(Boolean) as Unit[];
const nexts = d.next.map((id) => byId.get(id)).filter(Boolean) as Unit[];
const isEmpty = d.status === 'todo';
const ARROW = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
const sections = headings.filter((h) => h.depth === 2);
const issueUrl = `https://github.com/Seung1won-dot/K12-math/issues/new?title=${encodeURIComponent(`[${d.id}] ${d.title} 오류 신고`)}`;
---
<Base title={d.title} description={`${d.level} ${d.grade} ${d.term ?? ''} ${d.title} — 핵심 개념, 공식, 자주 하는 실수`} section={level}>
  {!isEmpty && <div slot="progress" class="read-progress" aria-hidden="true"></div>}
  <div class="unit-layout">
  <div class="unit-main">
  <article data-pagefind-body>
    <nav class="crumbs" aria-label="현재 위치" data-pagefind-ignore>
      <a href={levelUrl(level)}>{LEVEL_LABEL[level]}</a><span class="sep" aria-hidden="true">/</span><a href={`${levelUrl(level)}#${group}`}>{groupLabel(level, group)}</a>
    </nav>
    <header class="unit-head">
      <h1>{d.title}</h1>
      <div class="unit-head__meta">
        <span class="chip">{d.area}</span>
        <span class={`chip chip--${d.status}`} data-pagefind-ignore>{STATUS_LABEL[d.status]}</span>
        {d.reviewedAt && <span data-pagefind-ignore>최종 검토 {d.reviewedAt.toISOString().slice(0, 10)}</span>}
        <span data-pagefind-meta={`keywords:${d.keywords.join(', ')}`} hidden></span>
      </div>
    </header>

    {prereqs.length > 0 && (
      <aside class="callout" data-pagefind-ignore>
        <p class="callout__title">이 단원이 어려우면 먼저 볼 단원</p>
        <ul class="linklist">{prereqs.map((u) => <li><a class="linkcard" href={unitUrl(u.data.id)}><span class="linkcard__title">{u.data.title}</span> <span class="linkcard__meta">{u.data.level} {u.data.grade}{u.data.term ? ` ${u.data.term}` : ''}</span><Fragment set:html={ARROW} /></a></li>)}</ul>
      </aside>
    )}

    {isEmpty ? (
      <div class="callout callout--todo" data-pagefind-ignore>
        <p class="callout__title">아직 작성되지 않은 단원입니다</p>
        <p class="text-2">단원 목록에는 등록됐지만 내용은 준비 중입니다. 키워드: {d.keywords.join(', ') || '없음'}</p>
      </div>
    ) : (
      <>
        {headings.length > 0 && (
          <nav class="toc" aria-label="단원 목차" data-pagefind-ignore>
            {sections.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
          </nav>
        )}
        <div class="prose"><Content /></div>
      </>
    )}

    {nexts.length > 0 && (
      <aside class="callout" data-pagefind-ignore>
        <p class="callout__title">이 다음에 배우는 단원</p>
        <ul class="linklist">{nexts.map((u) => <li><a class="linkcard" href={unitUrl(u.data.id)}><span class="linkcard__title">{u.data.title}</span> <span class="linkcard__meta">{u.data.level} {u.data.grade}{u.data.term ? ` ${u.data.term}` : ''}</span><Fragment set:html={ARROW} /></a></li>)}</ul>
      </aside>
    )}
    {d.note && <p class="muted" data-pagefind-ignore>비고: {d.note}</p>}
  </article>

  <nav class="pager" aria-label="이전·다음 단원">
    {prev ? <a href={unitUrl(prev.data.id)}><span><i aria-hidden="true">←</i>이전 단원</span>{prev.data.title}</a> : <span />}
    {next ? <a class="next" href={unitUrl(next.data.id)}><span>다음 단원<i aria-hidden="true">→</i></span>{next.data.title}</a> : <span />}
  </nav>
  <p class="report">틀린 내용을 찾으셨나요? <a href={issueUrl} target="_blank" rel="noopener">오류 신고</a></p>
  </div>

  {!isEmpty && sections.length > 0 && (
    <aside class="unit-side" data-pagefind-ignore>
      <nav class="side-toc" aria-label="이 단원 목차">
        <p class="side-toc__title">이 단원에서</p>
        <ol>{sections.map((h, i) => <li><a href={`#${h.slug}`}><span class="num">{String(i + 1).padStart(2, '0')}</span><span>{h.text}</span></a></li>)}</ol>
        <a class="side-toc__top" href="#main">맨 위로 ↑</a>
      </nav>
    </aside>
  )}
  </div>
</Base>

<script>
  /* 단원 페이지에는 애니메이션 라이브러리를 싣지 않는다. 옆 목차의 현재 위치 표시와(스크롤 연동 CSS가 없는 브라우저용) 읽기 막대만 */
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.side-toc ol a')];
  const heads = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter((h): h is HTMLElement => !!h);
  if (heads.length) {
    // 화면 위쪽 40% 선을 지난 마지막 제목이 현재 절
    const setCurrent = () => {
      const passed = heads.filter((h) => h.getBoundingClientRect().top < window.innerHeight * 0.4);
      const cur = passed[passed.length - 1] ?? heads[0];
      links.forEach((a) => a.setAttribute('aria-current', String(decodeURIComponent(a.hash.slice(1)) === cur.id)));
    };
    const io = new IntersectionObserver(setCurrent, { rootMargin: '0px 0px -60% 0px' });
    heads.forEach((h) => io.observe(h));
    setCurrent();
  }

  const bar = document.querySelector<HTMLElement>('.read-progress');
  if (bar && !CSS.supports('animation-timeline: scroll()')) {
    let ticking = false;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? Math.min(1, window.scrollY / max) : 0})`;
      ticking = false;
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>
